{
  "name": "dsh-i-hao-hai-pa",
  "version": "1.2.3",
  "type": "module",
  "description": "When a user yells at DSH, the whole interface drops to pieces, trembles, and floats back up.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "easter-egg",
    "animation"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
